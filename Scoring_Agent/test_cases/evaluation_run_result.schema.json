{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation Run Result",
  "type": "object",
  "required": [
    "run_id",
    "timestamp",
    "deployment",
    "prompt_version",
    "case_id",
    "suite_mode",
    "suite_batch_id",
    "repeat_index",
    "scope",
    "request_status",
    "request_error",
    "scores",
    "scoring_trace",
    "guardrails_applied",
    "overrides_fired",
    "latency_ms",
    "token_usage",
    "pass_fail",
    "failure_reason",
    "raw_result_path",
    "root_causes"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "deployment": { "type": "string" },
    "prompt_version": { "type": "string" },
    "case_id": { "type": "string" },
    "suite_mode": { "type": "string", "enum": ["smoke", "repro"] },
    "suite_batch_id": { "type": "string" },
    "repeat_index": { "type": "integer", "minimum": 1 },
    "scope": { "type": "string", "enum": ["all", "real", "core"] },
    "request_status": {
      "type": "string",
      "enum": ["ok", "request_error", "malformed_output", "credential_error"]
    },
    "request_error": { "type": "string" },
    "scores": { "type": "object", "additionalProperties": { "type": "integer" } },
    "scoring_trace": { "type": "object" },
    "guardrails_applied": { "type": "array", "items": { "type": "string" } },
    "overrides_fired": { "type": "array", "items": { "type": "string" } },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "token_usage": { "type": "object", "additionalProperties": { "type": "integer" } },
    "pass_fail": { "type": "string", "enum": ["pass", "fail", "baseline_fail", "error"] },
    "failure_reason": { "type": "string" },
    "raw_result_path": { "type": "string" },
    "root_causes": { "type": "array", "items": { "type": "string" } }
  }
}
